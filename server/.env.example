# Copy this file to .env (which git ignores) and fill in the values.

# MongoDB Atlas connection string. Include the database name after ".net/",
# e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/qpgen?retryWrites=true&w=majority
MONGODB_URI=

# Long random text used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=5050

# Where the web app runs, for CORS. Comma-separate several.
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001
